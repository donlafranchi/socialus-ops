# General
.DS_Store
*.log
node_modules/
.claude/*
# ...except the shared permission allowlist, which must travel between machines.
# `.claude/skills/` stays ignored: skills are symlinked per-machine by
# ~/Projects/skills/link.sh and are not this repo's to carry.
!.claude/settings.json
.env.local
.idea/
*.swp

# Raw media — transcripts land as text, the source never enters git
*.mp4
*.mov
*.m4a
*.mp3
*.wav
__pycache__/
